:root {
    --container-height: 48px;
    --font-size: 40px;
}

.capped-value {
    height: var(--container-height);
}

.capped-value__background {
    position: relative;
    overflow: hidden;
    margin: 7px;
    flex-grow: 1;
    background-color: rgb(0, 0, 0);
}

.capped-value__ghost-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background-color: rgb(220, 212, 200);
}

.capped-value__hp-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background-color: rgb(226, 60, 52);
}

.capped-value__dividers {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.capped-value__divider--minor {
    position: absolute;
    top: 0;
    height: 100%;
    width: 3px;
    background-color: rgb(0, 0, 0);
}

.capped-value__divider--major {
    position: absolute;
    top: 0;
    height: 100%;
    width: 5px;
    background-color: rgb(0, 0, 0);
}

.capped-value__foreground {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Visuals/Sprites/UI/HeallthBar.png?fileID=9075789218899612779&guid=a925dec9143a480448d414acf1c1eb35&type=3#HeallthBar_0");
}

.capped-value__label {
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    font-size: var(--font-size);
    margin: 0;
    padding: 0;
}
