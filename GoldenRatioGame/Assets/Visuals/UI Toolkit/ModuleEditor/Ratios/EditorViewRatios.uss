:root {
    --left-panel: 30%;
    --right-panel: 30%;
    --center-panel: 40%;
    --current-items-container: 84%;
    --storage-height: 84%;
    --stats-container-height: 16%;
    --editor-buttons-container: 16%;
    --title-container-height: 10%;
    --augment-container-height: 25%;
}

.container {
    padding: 15px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
}

.statsContainer {
    height: var(--stats-container-height);
    min-height: var(--stats-container-height);
    max-height: var(--stats-container-height);
}

.storageContainer {
    height: var(--storage-height);
    min-height: var(--storage-height);
}

.currentItemsContainer {
    min-height: var(--current-items-container);
    height: var(--current-items-container);
    max-height: var(--current-items-container);
}

.graphEditorContainer {
    flex-grow: 1;
    margin-bottom: 100px;
}

.leftPanel {
    width: var(--left-panel);
}

.middlePanel {
    width: var(--center-panel);
}

.rightPanel {
    width: var(--right-panel);
}

.editorButtonsContainer {
    height: var(--editor-buttons-container);
}

.titleContainer {
    height: var(--title-container-height);
    margin-right: 20%;
    margin-left: 20%;
    margin-top: 20px;
    margin-bottom: 5px;
}

.augmentContainer {
    height: var(--augment-container-height);
}
